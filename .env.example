# --------------------------------------------------------------------------
# Violet subnet configuration
#
# One file drives the miner, the validator and the router. Each component reads
# only the section it needs, so most deployments leave the others blank.
# --------------------------------------------------------------------------

# --- chain (all components) ------------------------------------------------
# Violet subnet IDs: mainnet (finney) = 39, testnet = 292.
# Leave VIOLET_NETUID blank to pick automatically from BT_NETWORK.
VIOLET_NETUID=
BT_NETWORK=finney
# BT_NETWORK=test          # → netuid 292
BT_WALLET_NAME=default
BT_WALLET_HOTKEY=default
# BT_WALLET_PATH=~/.bittensor/wallets
VIOLET_LOG_LEVEL=INFO

# --- miner -----------------------------------------------------------------
# Must be publicly reachable. This is what validators and the router will dial.
# Prefer your stable public IP or DNS for the miner sidecar port:
#   MINER_PUBLIC_ENDPOINT=http://203.0.113.10:8091
#   MINER_PUBLIC_ENDPOINT=https://miner.example.com
# The chain axon does NOT discover this — announce publishes FROM this value.
# ./violet/miner/start.sh prompts for public IP and auto-detects service ports.
MINER_PUBLIC_ENDPOINT=https://miner.example.com
MINER_HOST=0.0.0.0
# Ports (stt_install → etoil :9090, tts_install.sh → Spark :8002)
MINER_PORT=8091
ASR_PORT=9090
TTS_PORT=8002
# asr, tts, or both
MINER_SERVICES=asr,tts

# Real inference on the host (install via violet/miner/stt_install.sh + tts_install.sh)
MINER_ASR_UPSTREAM=http://host.docker.internal:9090
MINER_TTS_UPSTREAM=http://host.docker.internal:8002
# etoil is batch-first; miner synthesizes WS partials via /transcribe
MINER_ASR_STREAM_MODE=batch_proxy

# Hugging Face token for STT/TTS model downloads (stt_install.sh / tts_install.sh).
# Set your own token and rotate if a shared default was ever exposed.
# HF_TOKEN=

# Declared image digests, checked against the published official set.
MINER_ASR_IMAGE=
MINER_TTS_IMAGE=

# Leave at 0 to derive admission limits from detected GPUs.
MINER_MAX_CONCURRENT_ASR=0
MINER_MAX_CONCURRENT_TTS=0

MINER_SERVE_AXON=true
MINER_ANNOUNCE_INTERVAL_S=3600
# Optional bearer token for production traffic. Validators are always allowed
# through unauthenticated, so this cannot be used to dodge evaluation.
# Prefer: ./violet/miner/fetch_access_token.sh test --write-env
# Default ASRAPI backend: https://phosai-backend-api-1.onrender.com
VIOLET_TOKEN_API_URL=https://phosai-backend-api-1.onrender.com
MINER_ACCESS_TOKEN=

# --- validator -------------------------------------------------------------
# launch | growth | mature  (see docs/INCENTIVE.md)
VIOLET_PHASE=launch
VIOLET_SCORE_WINDOW_DAYS=7
VIOLET_WEIGHT_INTERVAL_BLOCKS=150
VALIDATOR_EVAL_INTERVAL_S=300
VALIDATOR_HEALTH_INTERVAL_S=60
VALIDATOR_CONCURRENCY=8
VALIDATOR_DB_PATH=./data/validator.sqlite3
# Point at the standard SALT corpus (real audio → measurable WER).
# Build once:  pip install -e ".[eval]" && python scripts/build_salt_evalset.py --out ./data/evalset/salt
# Docs: docs/EVALSET.md
VALIDATOR_EVALSET_PATH=./data/evalset/salt
VALIDATOR_REQUIRE_IDENTITY=true
VIOLET_RELEASE_MANIFEST_PATH=
VALIDATOR_DASHBOARD_PORT=8092
VALIDATOR_DRY_RUN=false

# Signed organic work counters from the Avoices backend.
VIOLET_WORK_REPORT_URL=https://phosai-backend-api-1.onrender.com/api/admin/violet/work-report
VIOLET_WORK_REPORT_TOKEN=
VIOLET_WORK_REPORT_SIGNER=

# --- Cathedral SN39 (cathedral-voice / violet_audio external scores) --------
# Thin validators do NOT ingest scores. Post to the publisher; they pull the
# signed feed. See docs/CATHEDRAL_EXTERNAL_SCORES.md and docs/UNIFIED_SN39_VALIDATOR.md
CATHEDRAL_EXTERNAL_SCORES_ENABLED=false
CATHEDRAL_PUBLISHER_URL=https://api.cathedral.computer
# Use the direct publisher origin if edge returns route_not_served_by_cathedral_edge
CATHEDRAL_EXTERNAL_SCORES_TOKEN=
CATHEDRAL_EXTERNAL_SCORES_HMAC_SECRET=
CATHEDRAL_EXTERNAL_SCORES_NETUID=39
CATHEDRAL_EXTERNAL_SCORES_DRY_RUN=false
# CATHEDRAL_SKIP_LOCAL_WEIGHTS=false

# Colocated Cathedral thin SN39 relay (fetch signed feed → verify → set_weights)
CATHEDRAL_THIN_ENABLED=false
CATHEDRAL_THIN_BROADCAST=false
CATHEDRAL_THIN_DRY_RUN=true
CATHEDRAL_THIN_INTERVAL_S=1500
CATHEDRAL_WEIGHT_POLICY_PUBLIC_KEY=10890a66aa752479cb3b634f366d7bd27c374324d83f88d2d6b69ab066f25e26
CATHEDRAL_WEIGHT_POLICY_KEY_ID=cathedral-weight-policy
# CATHEDRAL_THIN_PREFER_SUBPROCESS=true
# CATHEDRAL_VALIDATOR_BIN=cathedral-validator

# --- router (embedded in the Avoices backend) ------------------------------
VIOLET_ROUTER_ENABLED=false
# The servers Avoices uses today. Keep them: they are the fallback.
VIOLET_FALLBACK_ASR_URL=http://31.56.109.67:9000
VIOLET_FALLBACK_TTS_URL=
VIOLET_DISCOVERY_INTERVAL_S=300
VIOLET_ROUTER_HEALTH_INTERVAL_S=30
VIOLET_ROUTER_UNHEALTHY_THRESHOLD=3
VIOLET_ROUTER_MAX_ATTEMPTS=3
VIOLET_ROUTER_MIN_INCENTIVE=0.0
# Must be on a persistent volume: this is the work history miners are paid on.
VIOLET_RECEIPTS_DB_PATH=./data/violet_receipts.sqlite3
VIOLET_WORK_REPORT_SIGNING_KEY=
# Separate HMAC secret for validators (recommended; falls back to token if unset)
VIOLET_WORK_REPORT_HMAC_SECRET=
VIOLET_MINER_ACCESS_TOKEN=
# Upload / WebSocket limits (miner sidecar)
MINER_MAX_UPLOAD_BYTES=52428800
MINER_MAX_CLONE_REFERENCE_BYTES=10485760
MINER_MAX_TTS_TEXT_CHARS=5000
MINER_WS_MAX_MESSAGE_BYTES=4194304
MINER_WS_IDLE_TIMEOUT_S=300
# Prod: require https:// on MINER_PUBLIC_ENDPOINT (set MINER_ALLOW_HTTP=1 to override)
MINER_ALLOW_HTTP=0

# --- Cathedral Voice production (hybrid receipts / TDX) --------------------
# See docs/CATHEDRAL_VOICE_PRODUCTION_ENV.md — leave simulation UNSET in prod.
# CATHEDRAL_TDX_SIMULATION=0
VIOLET_TTS_RECEIPT_ENABLED=0
VIOLET_TTS_RECEIPT_BUFFER=0
# VIOLET_RECEIPT_ED25519_PRIVATE_KEY=
# CATHEDRAL_RECEIPT_ED25519_PUBLIC_KEY=
# VIOLET_TDX_MEASUREMENT=
# VIOLET_TDX_CHALLENGE=
# VIOLET_TDX_AUDIENCE=cathedral_voice_hybrid
# VIOLET_TDX_EXPECTED_HOTKEY=
# VIOLET_TDX_EXPECTED_ENDPOINT=
# VIOLET_TDX_ALLOWED_MRTD=
# VIOLET_TDX_QUOTE_VERIFIER=/usr/local/bin/violet-tdx-quote-verify
# VIOLET_TDX_DCAP_VERIFIER=
VIOLET_REQUIRE_IMAGE_DIGESTS=1

# Validator semantic TTS + hybrid publish
# VALIDATOR_TRUSTED_ASR_URL=
# VALIDATOR_TRUSTED_ASR_TOKEN=
# VALIDATOR_TTS_SEMANTIC_REQUIRED=1
# VALIDATOR_TTS_HOLDOUT_PATH=
# CATHEDRAL_HYBRID_SCORES_ENABLED=0
# CATHEDRAL_HYBRID_ONLY=0
# CATHEDRAL_HYBRID_REQUIRE_TDX=1
# Dedicated publisher credentials for cathedral_voice_hybrid (do not reuse violet_audio):
# CATHEDRAL_EXTERNAL_SCORES_TOKEN_CATHEDRAL_VOICE_HYBRID=
# CATHEDRAL_EXTERNAL_SCORES_HMAC_SECRET_CATHEDRAL_VOICE_HYBRID=

# Selector weighting (must be sensible relative to each other, not normalised)
VIOLET_SELECT_W_LATENCY=0.4
VIOLET_SELECT_W_LOAD=0.4
VIOLET_SELECT_W_QUALITY=0.2
