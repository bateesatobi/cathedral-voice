# --------------------------------------------------------------------------
# Violet subnet configuration
#
# One file drives the miner, the validator and the router. Each component reads
# only the section it needs, so most deployments leave the others blank.
# --------------------------------------------------------------------------

# --- chain (all components) ------------------------------------------------
# Violet subnet IDs: mainnet (finney) = 39, testnet = 292.
# Leave VIOLET_NETUID blank to pick automatically from BT_NETWORK.
VIOLET_NETUID=
BT_NETWORK=finney
# BT_NETWORK=test          # → netuid 292
BT_WALLET_NAME=default
BT_WALLET_HOTKEY=default
# BT_WALLET_PATH=~/.bittensor/wallets
VIOLET_LOG_LEVEL=INFO

# --- miner -----------------------------------------------------------------
# Must be publicly reachable. This is what validators and the router will dial.
MINER_PUBLIC_ENDPOINT=https://miner.example.com
MINER_HOST=0.0.0.0
MINER_PORT=8091
# asr, tts, or both
MINER_SERVICES=asr,tts

# The official inference containers on this host.
MINER_ASR_UPSTREAM=http://violet-asr:9000
MINER_TTS_UPSTREAM=http://violet-tts:8080

# Declared image digests, checked against the published official set.
MINER_ASR_IMAGE=
MINER_TTS_IMAGE=

# Leave at 0 to derive admission limits from detected GPUs.
MINER_MAX_CONCURRENT_ASR=0
MINER_MAX_CONCURRENT_TTS=0

MINER_SERVE_AXON=true
MINER_ANNOUNCE_INTERVAL_S=3600
# Optional bearer token for production traffic. Validators are always allowed
# through unauthenticated, so this cannot be used to dodge evaluation.
MINER_ACCESS_TOKEN=

# --- validator -------------------------------------------------------------
# launch | growth | mature  (see docs/INCENTIVE.md)
VIOLET_PHASE=launch
VIOLET_SCORE_WINDOW_DAYS=7
VIOLET_WEIGHT_INTERVAL_BLOCKS=150
VALIDATOR_EVAL_INTERVAL_S=300
VALIDATOR_HEALTH_INTERVAL_S=60
VALIDATOR_CONCURRENCY=8
VALIDATOR_DB_PATH=./data/validator.sqlite3
# Point at a PRIVATE corpus with real audio. The built-in set cannot measure WER.
VALIDATOR_EVALSET_PATH=
VALIDATOR_DASHBOARD_PORT=8092
VALIDATOR_DRY_RUN=false

# Signed organic work counters from the Avoices backend.
VIOLET_WORK_REPORT_URL=https://api.voices.phosaico.com/violet/work-report
VIOLET_WORK_REPORT_TOKEN=
VIOLET_WORK_REPORT_SIGNER=

# --- router (embedded in the Avoices backend) ------------------------------
VIOLET_ROUTER_ENABLED=false
# The servers Avoices uses today. Keep them: they are the fallback.
VIOLET_FALLBACK_ASR_URL=http://31.56.109.67:9000
VIOLET_FALLBACK_TTS_URL=
VIOLET_DISCOVERY_INTERVAL_S=300
VIOLET_ROUTER_HEALTH_INTERVAL_S=30
VIOLET_ROUTER_UNHEALTHY_THRESHOLD=3
VIOLET_ROUTER_MAX_ATTEMPTS=3
VIOLET_ROUTER_MIN_INCENTIVE=0.0
# Must be on a persistent volume: this is the work history miners are paid on.
VIOLET_RECEIPTS_DB_PATH=./data/violet_receipts.sqlite3
VIOLET_WORK_REPORT_SIGNING_KEY=
VIOLET_MINER_ACCESS_TOKEN=

# Selector weighting (must be sensible relative to each other, not normalised)
VIOLET_SELECT_W_LATENCY=0.4
VIOLET_SELECT_W_LOAD=0.4
VIOLET_SELECT_W_QUALITY=0.2
